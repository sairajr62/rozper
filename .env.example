# Canonical site URL — used for OG tags, canonical links, and JSON-LD schema.
# Set to the actual domain on production; set to the preview URL on staging.
# Falls back to https://www.rozper.com if not set.
NEXT_PUBLIC_SITE_URL=https://www.rozper.com

# WordPress REST API base URL — only used if content/wp-cache/posts-raw.json
# is missing (e.g. fresh clone before running `node scripts/sync-wp-blogs.mjs`).
# Falls back to https://www.rozper.com/wp-json/wp/v2 if not set.
NEXT_PUBLIC_WP_API_URL=https://www.rozper.com/wp-json/wp/v2

# FloatChat website token — enables the FloatChat live-chat widget in app/layout.tsx.
# Leave unset to disable the widget (e.g. in local dev).
FLOATCHAT_WEBSITE_TOKEN=

# SEMrush API key — powers app/api/semrush. Without it, that route returns a
# 401 ("No SemRush API key provided.") instead of report data. Can also be
# supplied per-request via the `x-semrush-key` header.
SEMRUSH_API_KEY=

# GA4 service-account credentials JSON (single-line) — powers app/api/ga4/*.
# Without it, those routes return a 503 instead of analytics data.
GA4_CREDENTIALS_JSON=
